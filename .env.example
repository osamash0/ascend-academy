# =============================================================================
# Learnstation — Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUIRED
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_KEY=
# Alias for anon key (backend reads SUPABASE_ANON_KEY with fallback to SUPABASE_KEY)
SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (pgbouncer pooler)
DATABASE_URL=


# -----------------------------------------------------------------------------
# AI / LLM API Keys
# -----------------------------------------------------------------------------

# Provider mode. "openai_only" runs every text, vision and embedding call on
# OPENAI_API_KEY alone; the API and worker then REFUSE TO BOOT while any other
# provider key below is non-empty. "multi" (default) uses the free-tier
# failover chains. Set VITE_AI_PROVIDER_MODE to the same value so the UI hides
# the model picker. After switching an existing database, re-embed:
#   python -m backend.scripts.backfill_slide_embeddings --force
AI_PROVIDER_MODE=multi
VITE_AI_PROVIDER_MODE=multi
# Quality tier (tutor, quizzes, summaries) and bulk tier (per-slide analysis).
# OPENAI_BULK_MODEL / OPENAI_VISION_MODEL default to OPENAI_MODEL.
# Launch setting: OPENAI_MODEL=gpt-4.1-mini, OPENAI_BULK_MODEL=gpt-4.1-nano
OPENAI_MODEL=
OPENAI_BULK_MODEL=
OPENAI_VISION_MODEL=
# default: text-embedding-3-small (stored at 768 dims)
OPENAI_EMBED_MODEL=
# Fleet-wide $/day ceiling on OpenAI, and per-student $/month cap.
LLM_OPENAI_DAILY_COST_CEILING_USD=10
LLM_MONTHLY_USER_COST_CAP_USD=2

GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional LLM providers for orchestrator fallback chain
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Model id overrides -------------------------------------------------------
# Every provider in the chain retires model slugs without notice: a Sep 2026
# audit found 5 of 9 legs 404ing on models that had simply been withdrawn, with
# the failover silently routing all traffic to the one paid provider. Each leg's
# model id is therefore env-overridable, so the next retirement is a config
# change rather than a code change. Leave blank to use the shipped default
# (shown in the comment).
# default: openai/gpt-oss-120b
GROQ_MODEL=
# default: openai/gpt-oss-20b
GROQ_FAST_MODEL=
# default: gemini-flash-latest
GEMINI_MODEL=
# default: gemini-flash-lite-latest
GEMMA_MODEL=
# default: nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=
# Groq serves no vision model as of Sep 2026, so the Groq vision leg is OFF
# unless you set this. Verify any value here actually accepts a multi-part
# image `content` array before enabling it.
GROQ_VISION_MODEL=

# Cloudflare Workers AI (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------

REDIS_PASSWORD=
REDIS_URL=


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

ALLOWED_ORIGINS=
# REQUIRED: set this to your production URL, e.g. https://yourdomain.com or http://<server-ip>:3000
CORS_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# TRUSTED_PROXY_HOSTS — hosts/CIDRs allowed to set X-Forwarded-For (S-3)
# Comma-separated list. Defaults to loopback + Docker's standard bridge range
# (127.0.0.1,::1,172.16.0.0/12), which matches docker-compose.prod.yml's
# `ascend_net` network where only the `frontend` nginx container ever talks
# to `api` directly. Override this ONLY if your reverse proxy sits somewhere
# else (a pinned custom subnet, a cloud load balancer's known egress range).
# Do NOT set this to "*" — that trusts X-Forwarded-For from ANY caller,
# which lets a client forge its own IP and defeat per-IP rate limiting.
# -----------------------------------------------------------------------------

TRUSTED_PROXY_HOSTS=


# -----------------------------------------------------------------------------
# Feature flags (backend) — see backend/core/config.py
# -----------------------------------------------------------------------------

# Roadmap Phase 2.2 — mounts /api/v1/search (global search + course tutor).
# Must be set together with VITE_FEATURE_GLOBAL_SEARCH below: either half alone
# gives a UI with no route, or a route no UI reaches. Off by default.
FEATURE_GLOBAL_SEARCH=

# Ask Luna — mounts /api/v1/ask-luna (hint-first tutor with curated widgets).
# Set together with VITE_FEATURE_ASK_LUNA below. Off by default.
FEATURE_ASK_LUNA=

# -----------------------------------------------------------------------------
# Frontend build-time vars (passed as Docker build ARGs)
# -----------------------------------------------------------------------------

VITE_API_URL=
VITE_ANON_SALT=
# Roadmap Phase 1.1 — SRS review engine dashboard tile/route. Off by default.
VITE_FEATURE_REVIEW_ENGINE=
# Roadmap Phase 3.1 — student self-serve uploads ("My Materials"). Off by default.
VITE_FEATURE_STUDENT_UPLOADS=
# Roadmap Phase 2.2 — global search + course tutor (the ⌘K palette). Off by default.
# Built and merged; dark until this AND the backend FEATURE_GLOBAL_SEARCH are set.
VITE_FEATURE_GLOBAL_SEARCH=
# Ask Luna tutor page (/ask-luna). Dark until this AND backend FEATURE_ASK_LUNA are set.
VITE_FEATURE_ASK_LUNA=
VITE_GROQ_API_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SENTRY_DSN=


# -----------------------------------------------------------------------------
# PDF Parser
# -----------------------------------------------------------------------------

# Parser pipeline version: 2 (default), 3, or 4
PARSER_VERSION=
PARSER_LLM_MODEL=
LLM_TIMEOUT_SECONDS=
VISION_MODEL=

MINERU_API_URL=
LLAMAPARSE_RESULT_TYPE=
LLAMA_CLOUD_API_KEY=


# -----------------------------------------------------------------------------
# Feature Flags & Optional Config
# -----------------------------------------------------------------------------

ENABLE_NUDGE_SCHEDULER=
NUDGE_RUN_SECRET=
NUDGE_RUN_HOUR_UTC=

ENVIRONMENT=
APP_ENV=

QUIZ_BATCH_SIZE=
QUIZ_BATCH_OVERLAP=


# -----------------------------------------------------------------------------
# Monitoring & Error Tracking
# -----------------------------------------------------------------------------

SENTRY_DSN=
