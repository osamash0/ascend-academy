' F1 -- The transformation: lecture materials to structured educational content.
' HERO FIGURE. Chapter 1 (Introduction).
' Claim supported: the thesis title made visual. One PDF in; the original kept as
' the reading surface, plus a set of addressable learning objects derived from it,
' each feeding a capability that is live for students in production.
' Pinned at dfc20df6. Sources: backend/services/upload_service.py:13 (1-300 pages);
' backend/services/parser/unified_orchestrator.py:167-177 (PyMuPDF), :919 + page_blocks.py:201-219
' (text / figure / no_text routing), unified_orchestrator.py:717-748 (compact reading copy in lecture-pdfs); backend/services/ai/
' orchestrator.py:158 (8 slides per call); backend/services/parser/synthesis.py:163 (5-8 deck MCQs) + persist.py:299-343
' (insert_deck_quizzes; per-slide questions are discarded, unified_orchestrator.py:1171, :1289);
' backend/services/ai/embeddings.py:29 (768 dims); backend/services/parser/persist.py:4-5,233-258;
' capabilities: backend/api/v1/v4_reader.py:80,175 (explain, ask), :129-146 + v4_practice_service.py:3
' (practice from quiz_questions), :254 + v4_rehearsal_service.py:410 (checkpoint from slide text); backend/services/luna/context.py:13-33;
' backend/services/v4_spaces_service.py:865-899 (Home ask -> course tutor).
@startuml f1-transformation
!include _style.iuml

title From lecture materials to structured educational content

skinparam rectangle {
  BackgroundColor #FFFFFF
  FontSize 10
}

rectangle "**INPUT** — one PDF" as IN #F2F2F2 {
  rectangle "A lecture deck or a learner's own file, 1–300 pages\n----\n• text trapped in page layout  • no pages as data\n• no notion of a //concept//  • readable by people, opaque to software" as A
}

rectangle "**TRANSFORMATION** — in the worker, server-authoritative" as MID #DCDCDC {
  rectangle "1. Extract\npage text (PyMuPDF),\nstore the PDF" as T1
  rectangle "2. Route\ntext / figure /\nno-text pages" as T2
  rectangle "3. Synthesise\nbatched LLM,\n8 slides per call" as T3
  rectangle "4. Embed\n768-dim\nvectors" as T4
  T1 -right-> T2
  T2 -right-> T3
  T3 -right-> T4
}

rectangle "**OUTPUT** — the original, plus addressable objects" as OUT #F2F2F2 {
  rectangle "**Reading copy**\nthe PDF itself,\ncompacted" as O0
  rectangle "**Slide records**\ntitle · text · summary\n//needs_review, vision_routed//" as O1
  rectangle "**Quiz questions**\n5-8 four-option MCQs\nper deck, each on a slide" as O2
  rectangle "**Embeddings**\npgvector 768,\nHNSW index" as O3
  O0 -[hidden]right- O1
  O1 -[hidden]right- O2
  O2 -[hidden]right- O3
}

rectangle "**LIVE FOR STUDENTS** — production, 2026-11" as CAP #BFBFBF {
  rectangle "**Reader**\npages at once;\nExplain / Ask a page" as C0
  rectangle "**Luna sessions**\nthe page, its neighbours,\nrelated pages" as C1
  rectangle "**Practice**\nstored quiz questions;\ncheckpoints from the text" as C2
  rectangle "**Home ask**\ncourse tutor with\nrefusal + citations" as C3
  C0 -[hidden]right- C1
  C1 -[hidden]right- C2
  C2 -[hidden]right- C3
}

A -down-> T1
T1 -down-> O0
T3 -down-> O1
T3 -down-> O2
T4 -down-> O3

O0 -down-> C0
O1 -down-> C0
O1 -down-> C1
O2 -down-> C2
O1 -down-> C2
O3 -down-> C3

legend bottom
  Built, but off in production: mock exams and spaced review of quiz-derived cards.
endlegend

@enduml
