' F18 -- Evaluation setup.
' Chapter 6 (Evaluation). Concept diagram.
' Claim supported: four evaluation instruments exist at 2b8b1f7b, and they differ in
' what they can measure. The scorecard harness proves its scorers but cannot measure
' the live system; the retrieval grid produced F19's numbers; the parser benchmark is
' a pre-registered, blind, human-judged comparison of 11 text-extraction methods.
' Pinned at 2b8b1f7b. Sources: backend/eval/{golden_sets,pipeline,scorer,judge,run_eval}.py
' (run_eval.py:1-7; pipeline.py:78-104 LivePipeline refuses synthetic deck ids);
' backend/eval/retrieval_grid.py:1-45, data/golden_set.json (50 questions), verify_anchors.py;
' backend/eval/parser_bench/{blinding,schedule,ranking,checks,results}.py, ranking.py:1-15
' (Bradley-Terry, MM); docs/thesis/experiments/parser-benchmark/PROTOCOL.md:3,11 (frozen
' 2026-10-30, H1 with Bonferroni), LAB_LOG.md:263-268 (283 votes, 11 methods, H1 set);
' backend/eval/deck_lab.py:1-10; backend/eval/quiz_answer_check.py:1-10. No CI workflow
' runs any of them (.github/workflows/).
@startuml f18-evaluation-setup
!include _style.iuml

title Evaluation setup — four instruments, run by hand

skinparam rectangle {
  BackgroundColor #FFFFFF
  FontSize 10
}

rectangle "**A — Scorecard harness**\nrun_eval.py" as A #DCDCDC {
  rectangle "4 metrics with pass bands:\nquiz key, tutor faithfulness,\nretrieval precision, synthesis" as A1
  rectangle "proves each scorer catches a\nseeded regression (fake pipeline)" as A2
  rectangle "**cannot measure the live system**:\nsynthetic deck ids match no lecture" as A3
  A1 -down-> A2
  A2 -down-> A3
}

rectangle "**B — Retrieval grid**\nretrieval_grid.py" as B #BFBFBF {
  rectangle "50 hand-written questions\nover 6 real lectures;\nevery anchor verified" as B1
  rectangle "k x threshold grid, lecture\nand course regimes, with the\nrefusal gate's false refusals" as B2
  rectangle "**produced the numbers in F19**" as B3
  B1 -down-> B2
  B2 -down-> B3
}

rectangle "**C — Parser benchmark**\nparser_bench/" as C #BFBFBF {
  rectangle "11 extraction methods,\n24 judged pages; protocol\nfrozen before any vote" as C1
  rectangle "blind pairwise duels, one judge,\nhidden repeats; 283 votes" as C2
  rectangle "**Bradley-Terry ratings**, bootstrap\nintervals, Bonferroni-corrected H1" as C3
  C1 -down-> C2
  C2 -down-> C3
}

rectangle "**D — Offline probes**" as D #F2F2F2 {
  rectangle "Deck Lab: what the deck\nskeleton changes, no LLM call" as D1
  rectangle "Quiz answer check: probe of\nfalse drops and false keeps" as D2
  D1 -[hidden]down- D2
}

A -[hidden]right- B
A3 -[hidden]down- C1
B3 -[hidden]down- D1
C -[hidden]right- D

legend bottom
  Dark = produced reported results · mid = built, cannot run against the live system.
  None of the four runs in CI.
endlegend

@enduml
