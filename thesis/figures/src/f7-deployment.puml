' F7 -- Production deployment topology.
' Chapter 4 (Design). UML deployment diagram.
' Pinned revision dfc20df6 (2026-11-06). Claim supported: five containers on
' one small VM behind a host nginx that terminates TLS, plus managed and
' free-tier services for data, mail, monitoring and off-site backups.
' Sources: docker-compose.prod.yml:7-198, Dockerfile.frontend:14-62,
' deploy/server/heartbeat/*, deploy/server/offsite-backup/*,
' docs/runbooks/deploy-main-to-prod.md:6-9, docs/runbooks/domain-dns-and-email.md,
' docs/runbooks/monitoring-and-backups.md, docs/ops/2026-10-30-learnstation-app-move.md.
@startuml f7-deployment
!include _style.iuml

' No-break spaces pad three cluster titles so the arrows entering those
' clusters do not run through the title text.
title Production deployment topology

node "Browser\n//anon key in bundle//" as BR
cloud "**Cloudflare DNS**\nDNS only" as DNS

node "                                    **Hetzner CX23**\n                                    4 GB / 2 vCPU" as HOST {
  artifact "**systemd timers**\nheartbeat 5 min, backup 03:30" as TM
  artifact "**host nginx** + certbot\nTLS, old hosts 301" as PX #DCDCDC
  node "                                   Docker · bridge ascend_net" as DOCK {
    artifact "**frontend** nginx 1.27\n127.0.0.1:3000 only" as FE
    rectangle "one Dockerfile                        " as BE {
      artifact "**api**\n512M, 1 CPU" as API
      artifact "**worker**\n512M, 1 CPU" as WK
    }
    database "**redis** 256M\nvol redis_data" as RC
    queue "**redis-queue** 160M\nvol redis_queue_data" as RQ
  }
}

cloud "**Better Stack**\nsite check,\nheartbeats" as BS
cloud "**Cloudflare R2**\nage-encrypted\ndumps" as R2
cloud "**Supabase**\nPostgres, Auth, Storage" as SB
cloud "**Resend**\nauth e-mail" as RS
cloud "**LLM providers**" as LLM

BR .left.> DNS : resolve
BR --> PX : HTTPS
TM -[hidden]right- PX
PX --> FE
FE --> API
BE --> RC
BE --> RQ
TM --> BS : ping
TM ---> R2
TM ----> SB : pg_dump
BE ---> SB
BE ---> LLM
BR ------> SB
SB -left-> RS : SMTP

legend bottom
  Grey: server-only config. deploy/server/ holds the heartbeat and off-site scripts.
endlegend

@enduml
