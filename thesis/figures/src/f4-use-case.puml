' F4 -- Actors and goals.
' Chapter 3 (Requirements). UML use case diagram.
' Claim supported: students work in the v4 app; authoring a Space is gated on
' ownership, not role (any student or professor can create and publish one);
' the professor console and the admin tools remain classic.
' Pinned at 2b8b1f7b, production flags FEATURE_V4, _V4_READER, _LUNA_SESSIONS,
' _STUDENT_UPLOADS on. Sources: src/lib/auth.tsx:9 (roles); backend/core/auth_middleware.py:
' 260-263 (require_student, require_creator); backend/api/v1/v4_reader.py:80,175 (explain, ask),
' :129-146 (practice), :229 (rehearsal), :254 (checkpoint), :279 (teach-back);
' backend/api/v1/v4_luna.py:94-218 (sessions, memory, due practice); backend/api/v1/v4_spaces.py:
' 59,75 (create, publish), :85-94 (join, leave), :108 (ask), :137 (notes), :180 (uploads);
' backend/api/v1/v4_landing.py:34 (landing); backend/api/v1/launch_control.py:24,42;
' backend/api/v1/admin.py (roles, stats, LLM spend, backups, analytics reset);
' src/App.tsx:384-395,558-630 (classic tools behind their flags).
@startuml f4-use-case
!include _style.iuml

title Actors and goals (as implemented)

left to right direction
skinparam usecase {
  FontSize 10
}
skinparam nodesep 6
skinparam ranksep 50

actor "Student" as S
actor "Creator\n//student or professor//" as C
actor "Professor" as P
actor "Admin" as A

S --|> C
P --|> C

rectangle "Learnstation" {
  usecase "Read a Lesson;\nExplain or Ask a page" as U1
  usecase "Study with Luna" as U2
  usecase "Practise and rehearse: checkpoint,\nteach-back, due cards, exam" as U3
  usecase "Ask across a Space" as U5
  usecase "Join a Space,\nkeep notes" as U6
  usecase "Bring own files\ninto the Library" as U7
  usecase "Classic review queue,\nmock exam, study guide" as U8 #DCDCDC

  usecase "Create and\npublish a Space" as U9
  usecase "See how a Space\nis landing" as U10

  usecase "Upload, edit and\nbatch-review lectures" as U11
  usecase "Classic courses\nand analytics" as U12

  usecase "Roles, backups,\nanalytics reset" as U13
  usecase "Platform stats, LLM spend,\nLaunch Control" as U14
}

S --> U1
S --> U2
S --> U3
S --> U5
S --> U6
S --> U7
S --> U8

C --> U9
C --> U10

P --> U11
P --> U12

A --> U13
A --> U14

note "Shaded: built, but its flag is off in\nproduction, so the route answers 404.\nPublishing a Space puts a student's\nupload in other students' tutor context." as N1

@enduml
