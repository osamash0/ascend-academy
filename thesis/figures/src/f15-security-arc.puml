  state "4 · Profile trust columns frozen" as S4 : <size:9>20260620000000</size>\nBEFORE UPDATE trigger keeps XP,\nlevel, streaks, institution_verified\n**closes** forged badge, inflated XP
  state "5 · Professor reads rescoped" as S5 : <size:9>20260621000000</size>\nown enrolled students only\n**closes** the leak step 3 opened
  S1 -down-> S2
  S2 -down-> S3
  S3 -down-> S4
