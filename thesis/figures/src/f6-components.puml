' F6 -- Component view of the deployed system.
' Chapter 4. UML component diagram.
' Pinned revision 2b8b1f7b (2026-11-02). Claim supported: production runs five
' containers; LLM providers are called directly (no gateway); the database is
' reached on two paths, and the v4 app needs the direct asyncpg one.
' Sources: docker-compose.prod.yml:15-197, nginx.conf:26-29, Dockerfile.frontend:59,
' backend/main.py:267-279, :364-440, backend/core/database.py:150-190,
' backend/workers/arq_worker.py:83-103, :321-359, backend/services/upload_service.py:45-62, :325-336,
' backend/services/ai/orchestrator.py:92-138, :239-397.
@startuml f6-components
!include _style.iuml

title Component view (as deployed, five containers)

skinparam componentStyle uml2

component "**Browser**\nReact SPA" as BR

package "Hetzner CX23 -- Docker, one bridge network" {
  component "**frontend**\nnginx 1.27, static bundle\nproxies /api/ (prefix kept)" as FE
  rectangle "one Dockerfile" as BE {
    component "**api**\nFastAPI, 1 uvicorn worker\nv4 routers behind flags" as API
    component "**worker**\nArq, max_jobs 4\ncrons every 10 min" as WK
  }
  database "**redis**\ncache, allkeys-lru" as RC
  queue "**redis-queue**\nbroker + pub/sub\nnoeviction + AOF" as RQ
}

rectangle "**Supabase** (managed)" as SBC {
  component "Auth · PostgREST\n· Storage (HTTPS)" as REST
  database "Postgres\n+ pgvector" as PG
  REST -[hidden]down- PG
}

cloud "**LLM providers**, no gateway\nGroq · Google · OpenRouter\nMistral · Cloudflare · OpenAI\n//openai_only: OpenAI alone//" as LLM

BR --> FE : HTTPS / SSE
BR ---> REST : auth +\nRLS reads
FE --> API : /api/...

API --> RQ : enqueue, ZCARD,\nSUBSCRIBE
WK --> RQ : consume, heartbeat,\nPUBLISH parse:<hash>
BE --> RC

BE ---> REST : HTTPS, sync
BE ---> PG : asyncpg\n(DATABASE_URL)
BE ---> LLM

note right of PG
  v4 Spaces, reader, Luna and parse
  persistence need this pool. Unset,
  they fail, yet /health/ready answers
  200 (database "not_configured").
end note

@enduml
