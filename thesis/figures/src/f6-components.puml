' F6 -- Component view of the deployed system.
' Chapter 4. UML component diagram.
' Pinned revision dfc20df6 (2026-11-06). Claim supported: production runs five
' containers; LLM providers are called directly (no gateway); the database is
' reached on two paths, and the v4 app needs the direct asyncpg one.
' Sources: docker-compose.prod.yml:16-198, nginx.conf:26-29, Dockerfile.frontend:59,
' backend/main.py:267-279, :364-443, backend/core/database.py:150-190,
' backend/workers/arq_worker.py:83-103, :321-359, backend/services/upload_service.py:45-62, :325-336,
' backend/services/ai/orchestrator.py:92-138, :239-397.
@startuml f6-components
!include _style.iuml

title Component view (as deployed, five containers)

skinparam componentStyle uml2

component "**Browser**\nReact SPA" as BR

package "Hetzner CX23 -- Docker, one bridge network" {
  component "**frontend**\nnginx: serves the app,\nforwards /api/ to the API" as FE
  rectangle "one Dockerfile" as BE {
    component "**api**\nFastAPI, one process;\nnew routes behind switches" as API
    component "**worker**\nArq, at most 4 jobs;\nmaintenance every 10 min" as WK
  }
  database "**redis**\ncache, may drop\nold entries" as RC
  queue "**redis-queue**\njobs + messages,\nnever dropped, on disk" as RQ
}

rectangle "**Supabase** (managed)" as SBC {
  component "Auth · database web\ninterface · Storage (HTTPS)" as REST
  database "Postgres\n+ pgvector" as PG
  REST -[hidden]down- PG
}

cloud "**LLM providers**, no gateway\nGroq · Google · OpenRouter\nMistral · Cloudflare · OpenAI\n//one switch can limit//\n//this to OpenAI//" as LLM

BR --> FE : HTTPS / SSE
BR ---> REST : sign-in,\nreads
FE --> API : /api/...

API --> RQ : enqueue, length,\nprogress
WK --> RQ : jobs, heartbeat,\nprogress
BE --> RC

BE ---> REST : HTTPS, sync
BE ---> PG : direct\nconnection pool
BE ---> LLM


@enduml
