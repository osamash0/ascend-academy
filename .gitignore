# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
venv/
.venv/
__pycache__/
*.pyc

# Generated by backend/scripts/export_openapi.py — a CI build artifact
# (uploaded per-run), not a checked-in file.
docs/openapi.json

# Environment variables
.env
.env.*
# ...but the committed template (no real values) must stay tracked
!.env.example

# Claude Code developer-local settings (machine-specific paths)
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scratch & Env
.agent_scratch/
scratch/
# One-off probes written at the repo root during debugging. These connect to a
# live database and some run work at import time, so they must never be
# collected by pytest or committed.
/scratch_*.py
/test_rls.py
.claude/
Document-Insight-Engine/
mineru-env/
# Ignore litellm/ contents but track the gateway config (os.environ/ refs only,
# no secrets) — git won't descend into a fully-ignored dir, so use litellm/*.
litellm/*
!litellm/config.yaml
dump.rdb
pdf_testset/
# Loadtest credentials
backend/loadtest/.students.json

# Test coverage artifacts (untracked 2026-07-11 cleanup)
.coverage
coverage/
htmlcov/

# Large generated dataset (not source; regenerated from scrapers)
Dataset/

# Playwright run output. A failing e2e run drops screenshots and .webm video
# here; ~760KB of those had been committed. Regenerated on every run.
test-results/
playwright-report/

# Supabase CLI machine-local state (linked project ref, server versions).
# The project id that actually matters is tracked in supabase/config.toml;
# this directory is per-machine and is recreated by `supabase link`.
supabase/.temp/
