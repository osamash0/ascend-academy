# syntax=docker/dockerfile:1
# Stage 1: build the React app
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
# --mount=type=cache keeps the npm cache on the host between builds.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --cache /root/.npm --legacy-peer-deps

COPY . .

# These are baked into the static bundle at build time.
# VITE_API_URL defaults to /api so nginx can proxy to the backend.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_API_URL=/api
ARG VITE_LAZY_PDF_IMPORT=false
ARG VITE_ANON_SALT=learnstation-analytics-2026
ARG VITE_AI_PROVIDER_MODE=multi
# Feature switches. docker-compose.prod.yml derives each from its backend flag
# (FEATURE_V4 -> VITE_FEATURE_V4, ...), so the UI and its routes go on together.
ARG VITE_FEATURE_V4=0
ARG VITE_V4_DATA_MODE=live
ARG VITE_FEATURE_STUDENT_UPLOADS=0
ARG VITE_FEATURE_REVIEW_ENGINE=0
ARG VITE_FEATURE_EXAM_MODE=0
ARG VITE_FEATURE_STUDY_GUIDE=0
ARG VITE_FEATURE_GLOBAL_SEARCH=0
ARG VITE_FEATURE_ASK_LUNA=0
ARG VITE_FEATURE_LUNA_SESSIONS=0
# Browser error reporting. Empty = off; only an EU-region DSN (*.de.sentry.io) is used.
ARG VITE_SENTRY_DSN=

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_API_URL=$VITE_API_URL \
    VITE_LAZY_PDF_IMPORT=$VITE_LAZY_PDF_IMPORT \
    VITE_ANON_SALT=$VITE_ANON_SALT \
    VITE_AI_PROVIDER_MODE=$VITE_AI_PROVIDER_MODE \
    VITE_FEATURE_V4=$VITE_FEATURE_V4 \
    VITE_V4_DATA_MODE=$VITE_V4_DATA_MODE \
    VITE_FEATURE_STUDENT_UPLOADS=$VITE_FEATURE_STUDENT_UPLOADS \
    VITE_FEATURE_REVIEW_ENGINE=$VITE_FEATURE_REVIEW_ENGINE \
    VITE_FEATURE_EXAM_MODE=$VITE_FEATURE_EXAM_MODE \
    VITE_FEATURE_STUDY_GUIDE=$VITE_FEATURE_STUDY_GUIDE \
    VITE_FEATURE_GLOBAL_SEARCH=$VITE_FEATURE_GLOBAL_SEARCH \
    VITE_FEATURE_ASK_LUNA=$VITE_FEATURE_ASK_LUNA \
    VITE_FEATURE_LUNA_SESSIONS=$VITE_FEATURE_LUNA_SESSIONS \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN

# Cap the Node heap so the Vite/Rollup build can't OOM a small (4 GB) deploy
# host. Building in-place on the VPS is the memory hot-spot that required swap.
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build

# Stage 2: serve with nginx on port 3000
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
